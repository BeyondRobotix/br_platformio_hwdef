{
  "name": "br-stm32",
  "title": "Beyond Robotix STM32",
  "description": "PlatformIO platform for Beyond Robotix STM32 boards (MicroNode L431, MicroNodePlus H723, CoreNode H743)",
  "homepage": "https://github.com/BeyondRobotix/br_platformio_hwdef",
  "license": "MIT",
  "keywords": ["dev-platform", "ARM", "Cortex-M", "STM32", "BeyondRobotix"],
  "engines": {
    "platformio": "^6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BeyondRobotix/br_platformio_hwdef.git"
  },
  "version": "1.0.0",
  "frameworks": {
    "arduino": {
      "package": "framework-arduinoststm32",
      "script": "builder/frameworks/arduino.py",
      "description": "Arduino Wiring-based Framework for ST STM32 microcontrollers",
      "homepage": "https://github.com/stm32duino/Arduino_Core_STM32",
      "title": "Arduino"
    }
  },
  "packages": {
    "toolchain-gccarmnoneeabi": {
      "type": "toolchain",
      "owner": "platformio",
      "version": "~1.120301.0"
    },
    "framework-arduinoststm32": {
      "type": "framework",
      "owner": "platformio",
      "version": "~4.21200.0"
    },
    "framework-cmsis": {
      "type": "framework",
      "owner": "platformio",
      "version": "~2.60300.0"
    },
    "tool-openocd": {
      "type": "uploader",
      "owner": "platformio",
      "version": "~3.1200.0"
    }
  }
}
